<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: excluir todos los datos de la app de backups en la nube y de la
     transferencia entre dispositivos (sesión, token cifrado, caché del feed). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
